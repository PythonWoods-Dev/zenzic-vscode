#
# Terminal-recording image for the CLI demo assets.
#
# Deliberately not derived from the VS Code demo image. A terminal recording
# needs a pty, a Python, and a renderer; it needs no editor, no Xvfb and no
# xdotool. The editor image is 1.74 GB and exists for a different job, and
# depending on it made this pipeline break the day that image was pruned.
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl asciinema \
        fonts-dejavu-core fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

ARG AGG_VER=1.5.0
RUN curl -fsSL -o /usr/local/bin/agg \
      "https://github.com/asciinema/agg/releases/download/v${AGG_VER}/agg-x86_64-unknown-linux-gnu" \
    && chmod +x /usr/local/bin/agg

RUN useradd -m -u 1000 demo && python3 -m venv /home/demo/.venv && chown -R demo:demo /home/demo
USER demo
ENV PATH=/home/demo/.venv/bin:$PATH
