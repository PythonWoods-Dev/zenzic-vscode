{
  "name": "zenzic-vscode",
  "displayName": "Zenzic",
  "description": "Deterministic Documentation Quality Platform (DQP) for Markdown/MDX graphs in VS Code.",
  "version": "0.30.0",
  "publisher": "pythonwoods",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "zenzic",
    "markdown",
    "mdx",
    "static analysis",
    "security"
  ],
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PythonWoods-Dev/zenzic-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/PythonWoods-Dev/zenzic-vscode/issues"
  },
  "homepage": "https://github.com/PythonWoods-Dev/zenzic-vscode",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zenzic.restartServer",
        "title": "Zenzic: Restart Server"
      },
      {
        "command": "zenzic.startServer",
        "title": "Zenzic: Start Server"
      },
      {
        "command": "zenzic.stopServer",
        "title": "Zenzic: Stop Server"
      },
      {
        "command": "zenzic.computeDQS",
        "title": "Zenzic: Compute Global DQS"
      },
      {
        "command": "zenzic.showQualityPanel",
        "title": "Zenzic: Show Quality Status Panel"
      },
      {
        "command": "zenzic.showStatus",
        "title": "Zenzic: Show Status / Recovery"
      },
      {
        "command": "zenzic.troubleshoot",
        "title": "Zenzic: Troubleshoot & Repair Setup"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Zenzic",
      "properties": {
        "zenzic.executablePath": {
          "type": "string",
          "default": "zenzic",
          "description": "Path to the Zenzic executable or virtual environment binary. Supports ${workspaceFolder} and leading ~/ or ~\\."
        },
        "zenzic.autoProvision": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install the Zenzic CLI engine in an isolated environment (using uv or python3 venv) if it is not found on your system or at the configured path. No changes are made to your system Python, PATH, or shell configuration."
        },
        "zenzic.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply Zenzic's deterministic Quick Fixes (bare URLs, untagged code blocks, empty link text, malformed lists, heading punctuation) when a Markdown/MDX file is saved. Off by default: this rewrites file content on every save, which can surprise a workflow or conflict with another formatter also running on save -- enable it once you're comfortable with what it fixes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/vscode": "~1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "~6.0.2"
  }
}
